# Claude Code local settings (personal, not shared)
# Personal / working dumps (photos, Tripo, Gemini sheets, concepts).
# open-track player profiles + result dedupe
# runtime match telemetry (kept on the server, not in git)
.DS_Store
.claude/settings.local.json
.steam-electron-build/
.venv-mt/
.venv-opencc/
backend/players/open/**/*.json
backend/players/results/*.json
backend/players/sessions/*.json
backend/stats/matches/*.json
backend/stats/matches/.*.tmp
dist-electron/
dist/
misc/**
# Re-include icon pipeline + Steam art (must come AFTER misc/**).
#   src/  = TexturePacker masters (npm run icons:pack)
#   bank/ = unused / pick-from glyphs — committed, NOT packed
#   STYLE.md + tooling = regenerate on another machine
!misc/icons/
!misc/icons/src/
!misc/icons/src/**
!misc/icons/bank/
!misc/icons/bank/**
!misc/icons/STYLE.md
!misc/icons/manifest.json
!misc/icons/icons.tps
!misc/icons/pack-icons-tps.sh
!misc/icons/_regen_queue.txt
!misc/steam/
!misc/steam/**
node_modules/
.env.translate.local
arena-cases.json
