# Host-based front door for Melodan (melodan.com, www, play all point at branches/main).
# Upload this once as .htaccess next to index.html / web.html in branches/main.
# The deploy excludes .htaccess, so redeploys leave it alone.

RewriteEngine On

# melodan.com / www.melodan.com → marketing site
RewriteCond %{HTTP_HOST} ^(www\.)?melodan\.com$ [NC]
RewriteRule ^$ web.html [L]

# play.melodan.com → game
RewriteCond %{HTTP_HOST} ^play\.melodan\.com$ [NC]
RewriteRule ^$ index.html [L]
