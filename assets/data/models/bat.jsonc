// Air chaff — rigged by script (scripts/glb-rig-bat.mjs: body, head, three bones per wing,
// envelope weights) and GPU-skinned in the instance pools; the bird flocks use it too.
// `stretch` widens the silhouette for the flock read.
{
    "file": "models/units/bat.glb",
    "stretch": { "x": 1.45, "z": 1.1 },
    "instancedSkin": true,
    "animation": {
        "walk": { "clip": "walk" }, // flight beat, ~0.2 s like the old shader flap
        "idle": { "clip": "idle" }, // hover
        "fire": { "clip": "fire", "hitAt": 0.16 }, // bite between two hard beats
        "death": { "clip": "death" }, // twitch, wings fold under
    },
}
