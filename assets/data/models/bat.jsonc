// Air chaff (Wasp-like) — wing flap + stretched span for flock silhouette
{
    "file": "models/units/bat.glb",
    "stretch": { "x": 1.45, "z": 1.1 },
    // ~3× the crow's flap rate, hinge close to the body so the torso rides the stroke
    "wingFlap": {
        "flapAmp": 0.95,
        "flapSpeed": 31.5,
        "flapBias": -0.32,
        "tipFloor": 0.55, // more shoulder / body motion
        "tipPower": 0.95, // less tip-only whip
        "innerRFrac": 0.08, // hinge near center — body flexes with the wings
        "minYFrac": 0.06, // include more of the torso in the wing mask
        "maxYCutFrac": 0.02,
        "outerRScale": 1.02,
        "softYFrac": 0.05,
    },
}
