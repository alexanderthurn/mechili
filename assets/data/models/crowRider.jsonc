// Rigged crow rider, drawn by the instance pools with GPU skinning: the clips are
// baked into a bone texture at load (see instancedSkin.ts). Beak along +Z in the GLB.
{
    "file": "models/units/crow-rider.glb",
    "yawDeg": 90,
    "instancedSkin": true,
    "animation": {
        "walk": { "clip": "walk" }, // flight wingbeat
        "idle": { "clip": "idle" }, // lazy hover
        "fire": { "clip": "fire" }, // beak peck
        "death": { "clip": "death" }, // goes limp, wings roll under
    },
}
