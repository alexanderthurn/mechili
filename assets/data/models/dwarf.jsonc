// Rigged dwarf (Tripo, Mixamo skeleton), GPU-skinned in the instance pools.
// Faces +Z in the GLB. Tripo placed the right-hand joint ~10 cm above the wrist and
// retargeted the clips onto it, so the axe hand swung off the arm. Fixed before cutting:
// scripts/glb-move-joint.mjs moved the pivot into the wrist, and glb-prep-clips
// "freeze" locks mixamorig:RightHand to the forearm (no wrist bend; the axe rides the arm).
// Clips cut from Tripo's run / chop / fall / idle (the full 15 s idle loop) with scripts/glb-prep-clips.mjs;
// the source file also had pitch_baseball and volleyball as attack candidates.
// `scale` multiplies the auto-fitted size (default 1) for art tweaks.
{
    "file": "models/units/dwarf.glb",
    "yawDeg": 90,
    "scale": 3,
    "instancedSkin": true,
    "animation": {
        "walk": { "clip": "walk" }, // Tripo run
        "idle": { "clip": "idle" },
        // chop 1.1–2.55 s, hit ≈ 0.97 s in; ×2.05 fits attackInterval 0.7
        "fire": { "clip": "fire", "speed": 2.05 },
        // fall 0.4–2.9 s: lands toward its left, slightly forward
        "death": { "clip": "death", "fallLocal": { "x": -0.95, "z": -0.31 } },
    },
}
