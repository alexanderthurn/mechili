// Rigged hammerer (Tripo biped, Z-up rig), GPU-skinned in the instance pools.
// Clips from Tripo's preset:biped:walk / preset:biped:fire; idle built with
// scripts/glb-make-idle.mjs. AttackNode rides R_Hand (measured in the fire pose).
// No death clip: the procedural tip-over handles it.
{
    "file": "models/units/hammerer.glb",
    "yawDeg": 90,
    "instancedSkin": true,
    "animation": {
        "walk": { "clip": "walk", "speed": 1.35 },
        "idle": { "clip": "idle" },
        // authored ~1.5 s, sped up to fit attackInterval 0.7 (×2.3 → 0.65 s; ×2.85 read too quick)
        "fire": { "clip": "fire", "speed": 2.3 },
    },
}
