// Rigged ogre (Tripo biped, Z-up rig), GPU-skinned in the instance pools.
// Clips cut from Tripo's presets with scripts/glb-prep-clips.mjs (hips pinned
// in world space); idle built with scripts/glb-make-idle.mjs (walk upper body,
// rest-pose legs, slow breathing).
{
    "file": "models/units/ogre.glb",
    "yawDeg": 90,
    "instancedSkin": true,
    "animation": {
        "walk": { "clip": "walk", "speed": 0.55 }, // Tripo run
        "idle": { "clip": "idle" },
        // pitch_baseball 0–2.4 s (wind-up + throw), sped up to fit attackInterval 1.35
        // the throw lands 1.83 s in → the clip starts ~0.92 s ahead of the attack
        "fire": { "clip": "fire", "speed": 2, "hitAt": 1.83 },
        // ~3.0 s authored → ~1.4 s tip; the head falls toward the character's left
        "death": { "clip": "death", "speed": 2.2, "fallLocal": { "x": -1, "z": 0 } },
    },
}
