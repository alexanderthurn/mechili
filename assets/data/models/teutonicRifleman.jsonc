// Teutonic Rifleman — the Teutonic knight with an M4 welded to his right hand (glb-attach:
// misc/model-viewer/raw/teutonic-m4a1.glb, all 97 clips), body + rifle merged into one material
// (glb-merge-materials, 2048 atlas) for the instance pools. Faces +Z, hence yawDeg 90.
// Clips cut with glb-prep-clips: walk → walk, shoot 4.2–6.0 s → fire (kneeling, one kick),
// fall 0.9–2.4 s → death, warm_up → idle. Firing again before the clip ends keeps him kneeling.
// The shoot stance aims ~54° to his left: fire turned −54° (glb-clip-yaw) so the M4 points ahead.
{
    "file": "models/units/teutonicrifleman.glb",
    "yawDeg": 90,
    "scale": 3,
    "offset": { "y": -0.04 },
    "instancedSkin": true,
    "animation": {
        // Tripo walk, 2.33 s loop of two gait cycles; a planted foot slides back against the hips at
        // 0.583 GLB units/s, so a loop covers 1.36 — the game plays it so the feet keep pace with the ground
        "walk": { "clip": "walk", "stride": 1.36 },
        "idle": { "clip": "idle" }, // Tripo warm_up, 18.1 s (best loop end), the seam eased over 0.5 s
        "fire": { "clip": "fire", "hitAt": 0.5 }, // kneeling; the rifle kicks 0.5 s in
        // falls to his left, lies still from about 0.9 s
        "death": { "clip": "death", "fallLocal": { "x": -1, "z": 0 } },
    },
}
