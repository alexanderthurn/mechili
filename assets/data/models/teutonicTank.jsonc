// Teutonic Tank — Tripo mesh segmented into parts, rigged by script like the prism cannon
// (scripts/glb-rig-tank.mjs: every part on one rigid bone — hull, turret, cannon, barrel, MG,
// tracks, road wheels; the Teutonic stands in the hatch on the turret bone) and GPU-skinned in
// the instance pools. Source: misc/model-viewer/raw/teutonic-tank-parts.glb + teutonic-tank-rig.plan.json.
// Cannon along +X in the GLB; the AttackNode rides the recoiling barrel.
{
    "file": "models/units/teutonictank.glb",
    "instancedSkin": true,
    // the game centres a model on its bounding box — barrel included — so the hull sat 0.096 GLB
    // units behind the unit's centre; this puts it back on the footprint (× 2.264 normalized, −Z = ahead)
    "offset": { "z": -0.217 },
    // the sim aims the turret on its own (UnitType.vehicle): these bones turn about the Turret joint
    "turret": { "bones": ["Turret", "Cannon", "Barrel", "MG"] },
    // sits on the slope: road wheels over 0.476 along x and tracks at z ±0.159, GLB units
    "groundConform": { "length": 0.476, "width": 0.318 },
    // two track marks behind it, one under each belt
    "hoofprints": { "bones": ["Track_L", "Track_R"], "size": 0.07, "strength": 0.3, "track": true },
    "animation": {
        // the road wheels (r 0.034) turn 4× per loop: stride = 4 × 2π r, so they roll with the ground
        "walk": { "clip": "walk", "stride": 0.845 },
        "idle": { "clip": "idle" }, // standing; the turret scans ±10°
        "fire": { "clip": "fire", "hitAt": 0.04 }, // the shot: barrel kicks back into the turret
        // the turret blows off and lands beside the hull — a wreck where it stands
        "death": { "clip": "death", "turn": false },
    },
}
