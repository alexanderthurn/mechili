// The base game's definitions. Every file under data/units, data/buildings, data/models,
// data/talents, data/runes, data/commanders, data/roundCards and data/spells is loaded; ids must match file names.
{
    "id": "base",
    "version": 1,
    // Roster order = UNIT_TYPES order: shop grid, AI and every roster loop use it.
    "roster": [
        "dwarf",
        "goblin",
        "hammerer",
        "ogre",
        "archer",
        "wizard",
        "crowRider",
        "mortar",
        "ballista",
        "shield",
        "rocket",
        "hordeZombie",
        "hordeBrutSpawn",
        "hordeWebweaver",
        "hordeSpinne",
        "hordeFarmer",
        "hordeFarmerSpawn",
        "hordeKomtur",
        "bat",
    ],
    // Loaded and addressable by id, but never part of the roster
    // (e.g. posted from a building panel instead of bought in the shop).
    "offRoster": ["stronghold-archer"],
    // Base buildings, in construction / preload order.
    "buildings": ["command-tower", "research-center", "stronghold"],
    // Runes in catalog order: inventories, shop and round-card lists sort by it.
    "runes": ["earth", "fire", "water", "wind", "addi", "power", "vigor", "colossus", "wrath", "golden", "bulwark"],
    // Commanders a player can be offered, in draw order (offers are dealt from this list by seed).
    "commanders": ["air", "cost", "elite", "archer", "addi", "meteor", "speed", "giant", "tutor", "money", "cursed", "flanky"],
    // Loaded and addressable by id, never offered (tutorial lessons pick them).
    "hiddenCommanders": ["tutorial", "tutorial2", "tutorial3"],
    // Between-round unit and spell cards, in draw order. Rune cards come from data/runes.
    "roundCards": ["dwarves4", "archers4", "crowRiders2", "ballista1", "flanky", "rallyRoute", "sellPack", "movePack"],
    // Spells (tactics) in catalog order: settings sheet and homepage lists follow it.
    "spells": [
        "rallyRoute",
        "oilSpill",
        "sellUnit",
        "moveUnit",
        "tutor",
        "spawnDwarves",
        "bigMeteor",
        "spawnCrows",
        "hammerOfGods",
        "storm",
        "meteorShower",
        "acidSpill",
        "fireSpill",
        "dragonAttack",
        "poisonCloud",
    ],
}
