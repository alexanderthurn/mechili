{
    "id": "earthRise",
    "name": "Earth Rise",
    "icon": "item-earth",
    "kind": "placement",
    "targeting": "two-point",
    "cooldownRounds": 2,
    "radius": 6, // the drawn line's width on the aim preview (the ridge itself is 5.2 to each side)
    "maxSpan": 64, // a long line, longer than the other capsules
    // no safe zone needed: the ridge leaves buildings alone by itself, and it blocks nobody from walking
    "respectsSafeZone": false,
    "vanguardCost": 250, // sold at the Vanguard (Command Tower) to every commander, once per match
    "spell": {
        "delaySeconds": 2,
        // A thin, steep ridge: high enough to read as a wall and break up a charge, low enough
        // that shots still clear it. It never goes away (terrain does not heal) and leaves
        // buildings alone.
        "raise": { "height": 3, "halfWidth": 5.2, "riseSeconds": 2.5 },
    },
    "marker": {
        "glow": "rgba(54, 40, 18, 0.55)",
        "capsule": { "fill": "#4a3a22", "line": "#c9a45a" },
    },
    "description": "Draw a line: a thin, steep ridge of earth rises along it a couple of seconds into the battle. It blocks low shots (high arcs still clear it), but units walk right over it. It cannot be removed and stays for the whole match. Buildings are left alone.",
}
