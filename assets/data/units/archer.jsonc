    "itemSlots": 2,
    "voice": {
        "externalIds": [
            {
                "type": "e",
                "id": "evLGnCoTdWnLh7fJtLdf",
                // snobby + a bit dim (Generals-style select bark)
                "prompt": "A snobby, slightly dumb adult male sniper voice — ice-cold swagger with dim arrogance. Every syllable is an aimed shot: crisp, clipped, supremely confident but not especially bright. Super cool, arrogant, zero panic. Lean and lethal, never soft, never booming ogre, never squeaky. Perfect audio quality.",
            },
        ],
        "lines": {
            // distinct select acks (one take each — no same-line variants)
            "pick": [
                "Yes?",
                "What?",
                "One shot, one opportunity",
            ],
            // cheeky brush-off when a rival clicks
            "pickRival": [
                "Wrong side.",
                "Buzz off.",
                "Not yours."
            ],
            "death": ["Noo!", "Uargh!"],
            // hit flinch — one syllable each (near-field on flesh impacts)
            "hurt": ["Ah!", "Ow!", "Eh!", "Ih!", "Oh!", "Uh!", "Auw!"],
        },
    },
