/**
 * Low free-flight dive flock — Komtur wave air chaff. Not shop-buyable for
 * now; flip {@link UnitType.buyable} when dual-use is wanted.
 */
{
    "id": "bat",
    "name": "Bat",
    "cost": 100,
    "unlockCost": 0,
    "hpWithdraw": 2,
    "buyable": false,
    "horde": true,
    // Neat lattice (1 bat per cell) — no formationSpread jitter
    "footprint": { "cols": 6, "rows": 2 },
    "formation": { "cols": 6, "rows": 3 }, // 18 ordered flock
    "meshScale": 1.0,
    "flying": 5.5, // low cruise — not crow-height
    "freeFlight": true, // climb/dive toward foes; pitch at aim
    "burn": { "takenMult": 1 }, // air: burn status ignored while aloft
    "targets": { "ground": true, "air": true },
    "collisionRadius": 0.9, // unused for soft push (ghost), kept for broadphase
    "soundSize": "small",
    "talentMod": {
        "blightburst": { "onDeath": { "acid": { "radius": 0.2 } } },
    },
    "blobShadowScale": 0.55,
    // Generous AA volumes — wings + body so goblin/archer volleys can connect
    "colliders": [
        { "y": 0.4, "r": 0.85 },
        { "y": 0.5, "r": 1.35 },
    ],
    "hp": 10,
    "bloodScale": 0.28, // tiny body — don't fountain like a dwarf
    "damage": 2, // chip — pressure from numbers, not punches (3 before bats stopped circling close foes)
    "range": 2.2, // touch radius while piercing
    "meleeLunge": 5, // commit the pass from a bit out
    "attackInterval": 1.05,
    "speed": 12,
    "turnRate": 3.2, // slow bank — points then flies along facing
    "turnMove": "cruise",
    "proceduralModel": "bat",
    "talents": ["legs", "ap", "aegis", "galeGate", "regeneration", "bloodfeast", "carrionFeast", "blightburst", "ruinousEnd"],
    "talentSlots": 4,
    "voice": {
        "externalIds": [
            {
                "type": "e",
                "id": "9VZaNevhiqC1wX0vmS51",
                "prompt": "An UNHOLY tiny-to-mid shrieking bat-creature voice — wet, fluttery, and nightmarishly gleeful. Speaks in skittering bursts with vampire-cartoon evil and comic hunger. Super creepy AND funny, never human-normal, never deep heroic. Perfect audio quality.",
            },
        ],
        "lines": {
            // select acks
            "pick": [
                "Yesyes?",
                "Hungry!",
                "We fly!",
                "Call me Nos!",
                "Dracula-lite!",
                "Where's Mina?",
                "Scree for dinner!",
                "Upside down ready!",
                "Night shift!",
                "Blood? Optional!",
                "Echo locate!",
                "Cape optional!",
            ],
            // cheeky brush-off when a rival clicks
            "pickRival": [
                "Not food!",
                "Mine!",
                "Shoo!"
            ],
            // death yelps
            // pack flock: one syllable only
            "death": [
                "Scree—!",
                "Dark!",
            ],
            // hit flinches — one syllable
            "hurt": [
                "Eek!",
                "Skree!",
                "Ih!",
                "Yip!",
                "Ack!",
            ],
        },

    },
}
