    "itemSlots": 2,
    "voice": {
        "externalIds": [
            {
                "type": "e",
                "id": "YD59iNtqR2aNRknyrg8x",
                "prompt": "The crow itself speaking — a SUPER intelligent battle-bird voice, all harsh caws twisted into words. Raspy avian screech with wicked animal cunning, wingbeat rhythm in the cadence, gleefully cruel from the sky. Not a human rider; pure crow personality, chaotic and loud. Never soft human speech, never noble knight. Perfect audio quality.",
            },
        ],
        "lines": {
            // select acks
            "pick": [
                "Caw?",
                "Above!",
                "We see you.",
                "Huginn reporting!",
                "Muninn forgot!",
                "Nevermore… maybe!",
                "Poe would approve!",
                "Feathers first!",
                "Air mail!",
                "Where's Odin?",
                "Cawtain speaking!",
                "Perch secured!",
            ],
            // cheeky brush-off when a rival clicks
            "pickRival": [
                "Caw off!",
                "Not yours.",
                "Fly away."
            ],
            // death yelps
            // sparse flock — short yelps + one longer line ok
            "death": [
                "Caaaw—!",
                "Falling!",
                "Caw!",
            ],
            // hit flinches — one syllable
            "hurt": [
                "Caw!",
                "Rak!",
                "Krr!",
                "Ah!",
                "Skree!",
            ],
        },

    },
