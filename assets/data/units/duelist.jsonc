{
    // DRAFT — listed in pack.jsonc "drafts", so not loaded by the game yet. Stats are placeholders.
    // Human single hero: Lancelette, a trans woman fencer and the loudest showoff on the board.
    // Seeks out the strongest single enemy and runs it through: rare, very strong single strikes on
    // ground targets — an anti-tank specialist, wasted against swarms.
    // Humour rule: she is always in on the joke and the jokes land on her enemies, never on her identity.
    "id": "duelist",
    "name": "Lancelette",
    "cost": 200,
    "unlockCost": 100,
    "footprint": { "cols": 2, "rows": 2 },
    "formation": { "cols": 1, "rows": 1 }, // one of a kind
    "meshScale": 2.2,
    "burn": { "takenMult": 1.0 },
    "targets": { "ground": true, "air": false }, // ground only — the sky is not her stage
    "collisionRadius": 0.9,
    "soundSize": "medium",
    "colliders": [{ "y": 1.1, "r": 0.75 }],
    "hp": 600,
    "damage": 320, // one big thrust per attack — a tank killer
    "range": 2.5,
    "attackInterval": 2.2, // slow, deliberate single strikes
    "speed": 8,
    "turnRate": 14,
    "meleeLunge": 4,
    // PLANNED mechanics (not in the sim yet): picks the enemy with the most max HP in reach and
