    // "targetPriority": "strongest",
    // "duel": { "damageMultVsSingle": 2.5 },
    "proceduralModel": "duelist",
    "talentSlots": 4,
    "itemSlots": 2,
    "voice": {
        "externalIds": [
            {
                "type": "e",
                "id": "Lnu5aAh5ogANoC6QniNs",
                "prompt": "A flamboyant, supremely confident female voice — a trans woman fencing champion with a smoky low alto, a little rasp, and diva theatre in every syllable. Sassy, quick-witted, dramatic pauses before the punchline, a delighted laugh never far away. Glamorous and fearless, very funny, never bitter, never shy, never villainous. Perfect audio quality.",
            },
        ],
        "lines": {
            // select acks — diva swordswoman, short and on point; she owns every joke
            "pick": [
                "Lancelette, darling.",
                "Sir? Dame? En garde!",
                "New name, same blade.",
                "Born to duel.",
                "The big one!",
                "Heels on, foes down.",
                "Out and proud.",
                "I'm the final phase.",
                "Pronouns: touché.",
                "Estrogen and steel.",
                "Cute ogre.",
                "Fashionably lethal.",
                "Never subtle.",
            ],
            // cheeky brush-off when a rival clicks
            "pickRival": [
                "Not your darling.",
                "Try misgendering this.",
                "Not the hair.",
                "Can't afford me.",
