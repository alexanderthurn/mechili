    "itemSlots": 2,
    "voice": {
        "externalIds": [
            {
                "type": "e",
                "id": "n4BUXN8IZOgxLDpCBtUL",
                "prompt": "A SUPER thick, ale-soaked male dwarf voice — booming belly laugh energy, proud to the point of absurdity. Heavy gravel, rolling R's, and stubborn bellowing like a pub anthem in human form. Loud, funny, unkillably confident, never whispery, never elegant. Perfect audio quality.",
            },
        ],
        "lines": {
            // select acks — hungry, ale-soaked, stubborn (the fun stereotypes)
            "pick": [
                "Aye?",
                "Ready!",
                "For the clan!",
                "At yer service!",
                "Say the word!",
                "Stone and steel!",
                "I am Grumpy!",
                "My name is Dumpy!",
                "Where is Durin?",
                "Where's the pie?",
                "Ale first!",
                "Got snacks?",
            ],
            // cheeky brush-off when a rival clicks
            "pickRival": [
                "Wrong clan.",
                "Back off.",
                "Not for ye.",
                "Keep walkin'.",
                "Nae chance.",
                "Bugger off.",
                "Hands off my lunch!",
                "That's me pie!",
                "Short fuse, pal.",
            ],
            // death yelps — pack unit: one syllable only (many die at once)
            "death": [
                "Och!",
                "Nae!",
            ],
            // hit flinches — one syllable
            "hurt": [
                "Ah!",
                "Oof!",
                "Gah!",
                "Ow!",
                "Ugh!",
            ],
