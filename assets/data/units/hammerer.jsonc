{
    // Fantasy Arclight — single pack, medium-range splash vs chaff (dwarfs / goblins)
    "id": "hammerer",
    "name": "Hammerer",
    "cost": 100,
    "unlockCost": 0,
    "footprint": { "cols": 2, "rows": 2 },
    "formation": { "cols": 1, "rows": 1 },
    "meshScale": 2.4,
    "burn": { "takenMult": 0.85 },
    "targets": { "ground": true, "air": false }, // AA is a later tech (like Arclight)
    "collisionRadius": 1.1,
    "soundSize": "medium",
    "colliders": [{ "y": 1.0, "r": 0.85 }],
    "projectileSpeed": 75,
    "projectileStyle": "stone", // crow rock pool — InstancedMesh
    // grow in flight: pebble → ~splash disk radius (stone mesh r≈0.84)
    "projectileScale": 0.28,
    "projectileScaleEnd": 4.285714285714286, // (4 / 0.84) × 0.9 — ~90% of splash disk radius
    "projectileBallistic": true,
    "projectileLaunchHeightFrac": 0.7,
    "splashRadius": 4, // Arclight-like blast vs packed chaff
    "hp": 240,
    "damage": 40, // a bare L1 dwarf's 40 HP exactly — dwarf veterancy, golden aura or costControl all break the one-shot
    "range": 32,
    "attackInterval": 0.7,
    // pistol draw windup — same field as ogre smash; shot leaves ~0.5s into the fire anim
    "meleeHitDelay": 1,
    "speed": 4.5,
    "turnRate": 5,
    "proceduralModel": "hammerer",
    // range / damage pivots
    "talents": ["barrel", "ap", "powerDraw", "veteranAim"],
    "talentSlots": 4,
    "voice": {
        "externalIds": [
            {
                "type": "e",
                "id": "aBAkYiBKqd98rqfoBNLR",
                "prompt": "A MASSIVE slow thunder-male voice of a siege giant with a warhammer for a soul. Each word drops like a boulder — deep, delayed, apocalyptic calm. Terrifyingly patient, zero humor, pure crushing inevitability. Super heavy, super ominous, never squeaky. Perfect audio quality.",
            },
        ],
        "lines": {
            // select acks
            "pick": [
                "Yes.",
                "Strike.",
                "I am ready.",
            ],
            // death yelps
            "death": [
                "…Falling.",
                "Silence.",
            ],
            // hit flinches — one syllable
            "hurt": [
                "Hn.",
                "Uh.",
                "Mm.",
                "Ah.",
            ],
        },

    },
}
