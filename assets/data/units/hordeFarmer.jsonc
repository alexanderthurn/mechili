/**
 * Der Komtur's forest levy — `horde2.glb` farmer. `buyable: false`.
 */
{
    "id": "hordeFarmer",
    "name": "Dead Farmer",
    "cost": 200, // bought by The Komtur's side
    "unlockCost": 50,
    "xpValue": 14.5833, // kill XP as before the price change
    "hpWithdraw": 7,
    "buyable": false,
    "horde": true,
    "modelId": "horde2",
    "footprint": { "cols": 6, "rows": 2 }, // a normal pack plate
    "formation": { "cols": 6, "rows": 2 }, // 12 — fewer than Brut swarm
    "formationSpread": 0.75,
    "meshScale": 1.7, // 2× prior 0.85
    "burn": { "takenMult": 0.5 },
    "bloodColor": 9236248 /* 0x8cef18 */,
    "targets": { "ground": true, "air": false },
    "collisionRadius": 0.9,
    "soundSize": "small",
    "colliders": [{ "y": 0.55, "r": 0.95 }],
    "sandWeight": 0.25,
    "innateTechs": ["darkHarvest"],
    "hp": 200,
    "damage": 100,
    "range": 2,
    "attackInterval": 0.7,
    "speed": 12,
    "turnRate": 4,
    "proceduralModel": "dwarf",
    // standard talents for The Komtur's side (Dark Harvest stays innate)
    "talents": ["bloodRage", "armor"],
    "talentSlots": 4,
    "voice": {
        "externalIds": [
            {
                "type": "e",
                "prompt": "A tragic-comic undead farmer voice — rural drawl warped by death, polite and wrong. Speaks like offering crops while dripping grave dirt, darkly funny and deeply cursed. Super uncanny valley humor-horror. Perfect audio quality.",
            },
        ],
        "lines": {
            // select acks
            "pick": [
                "Evenin'?",
                "Need a hand?",
                "Crops.",
            ],
            // cheeky brush-off when a rival clicks
            "pickRival": [
                "Wrong field.",
                "Private.",
                "Shoo."
            ],
            // death yelps
            "death": [
                "Harvest's done…",
                "Tell the missus…",
            ],
            // hit flinches — one syllable
            "hurt": [
                "Ow!",
                "Ah!",
                "Oof!",
                "Hey!",
                "Ugh!",
            ],
        },

    },
}
