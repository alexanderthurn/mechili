    "id": "hordeFarmer",
    "name": "Dead Farmer",
    "cost": 200, // bought by The Komtur's side
    "unlockCost": 50,
    "xpValue": 14.5833, // kill XP as before the price change
    "hpWithdraw": 7,
    "buyable": false,
    "horde": true,
    "modelId": "farmer",
    "footprint": { "cols": 6, "rows": 2 }, // a normal pack plate
    "formation": { "cols": 6, "rows": 2 }, // 12 — fewer than Brut swarm
    "formationSpread": 0.75,
    "meshScale": 1.133, // 2/3 of the old size with the rigged model
    "walkAnimRate": 0.194, // walk playback at ground speed 1.0 — first guess from the goblin's run, scaled by size
    "burn": { "takenMult": 0.5 },
    "bloodColor": 9236248 /* 0x8cef18 */,
    "targets": { "ground": true, "air": false },
    "collisionRadius": 0.6,
    "soundSize": "small",
    "colliders": [{ "y": 0.37, "r": 0.63 }],
    "sandWeight": 0.25,
    "innateTechs": ["darkHarvest"],
    "hp": 200,
    "damage": 100,
    "range": 2,
    "attackInterval": 0.7,
    "speed": 8,
    "turnRate": 4,
    "proceduralModel": "dwarf",
    // standard talents for The Komtur's side (Dark Harvest stays innate)
    "talents": ["bloodRage", "armor"],
    "talentSlots": 4,
    "voice": {
        "externalIds": [
            {
                "type": "e",
                "id": "M81OaVwHPJGMm34uTayT",
                "prompt": "A cursed undead farmer voice — rural drawl warped by death, polite and SUPER EVIL. Speaks like offering crops while dripping grave dirt; uncanny, wrong, and quietly murderous. Deeply cursed horror, never wholesome, never soft. Perfect audio quality.",
            },
        ],
        "lines": {
            // select acks
            "pick": [
                "Evenin'…",
                "Need a hand?",
                "Blood crops.",
                "Soil wants you.",
                "Plow the living.",
                "Where's the meat?",
                "Grave dirt ready.",
                "Harvest screams.",
                "Bones first.",
                "Scarecrow hungers.",
                "Barn of corpses!",
                "Hoe… the soft ones.",
            ],
            // cheeky brush-off when a rival clicks
            "pickRival": [
                "Wrong field.",
                "Private graves.",
                "Shoo… or join."
            ],
            // death yelps
            // pack unit: one syllable only
            "death": [
                "Ah!",
                "Urgh!",
            ],
            // hit flinches — one syllable
            "hurt": [
                "Ow!",
                "Ah!",
                "Oof!",
                "Hey!",
                "Ugh!",
            ],
        },

    },
}
