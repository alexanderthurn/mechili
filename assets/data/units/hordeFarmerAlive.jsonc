 */
{
    "id": "hordeFarmerAlive",
    "name": "Farmer",
    "cost": 100,
    "unlockCost": 0,
    "buyable": false,
    "horde": true,
    "modelId": "horde2",
    "footprint": { "cols": 6, "rows": 2 },
    "formation": { "cols": 6, "rows": 2 }, // 12, like the Dead Farmer
    "formationSpread": 0.75,
    "meshScale": 1.6,
    "burn": { "takenMult": 1.0 }, // still alive — fire hurts
    "targets": { "ground": true, "air": false },
