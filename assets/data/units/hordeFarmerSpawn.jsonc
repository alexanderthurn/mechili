/**
 * On-kill spawn from Dark Harvest — half the Dead Farmer in size and combat
 * weight, 1×1 so each kill raises one body. No Dark Harvest (no chain).
 */
{
    "id": "hordeFarmerSpawn",
    "name": "Dead Farmhand",
    "cost": 0,
    "levelBasis": 100, // free to gain, but 50 per level and 100 xp per level
    "hpWithdraw": 4,
    "buyable": false,
    "horde": true,
    "modelId": "farmer",
    "footprint": { "cols": 2, "rows": 2 },
    "formation": { "cols": 1, "rows": 1 },
    "meshScale": 0.567, // 2/3 of the old size with the rigged model
    "walkAnimRate": 0.387, // walk playback at ground speed 1.0 — first guess from the goblin's run, scaled by size
    "burn": { "takenMult": 0.5 },
    "bloodColor": 9236248 /* 0x8cef18 */,
    "targets": { "ground": true, "air": false },
    "collisionRadius": 0.3,
    "soundSize": "small",
    "colliders": [{ "y": 0.19, "r": 0.32 }],
    "sandWeight": 0.125,
    "hp": 100,
    "damage": 50,
    "range": 2,
    "attackInterval": 0.7,
    "speed": 8,
    "turnRate": 5,
    "proceduralModel": "dwarf",
    "voice": {
        "externalIds": [
            {
                "type": "e",
                "id": "cjzeyGY8r2N07tXVfpm7",
                "prompt": "A pathetic-terrifying undead farmhand voice — thin, eager, cracked-smile SUPER EVIL. Speaks like a loyal helper who should not exist; sad, wrong, and hungry for graves. Never bossy, never regal, never wholesome. Perfect audio quality.",
            },
        ],
        "lines": {
            // select acks
            "pick": [
                "Help…?",
                "Yes… kill!",
                "I can dig!",
                "Tiny graves!",
                "Sprout of doom!",
                "Where's da meat?",
                "Dirt… friend?",
                "Seed of ruin!",
                "I dig… deeper!",
                "Weeds of flesh!",
                "Mud… and blood!",
                "Grow… to eat!",
            ],
            // cheeky brush-off when a rival clicks
            "pickRival": [
                "Not yours!",
                "Go… die!",
                "Help—elsewhere!"
            ],
            // death yelps
            // swarm spawn: one syllable only
            "death": [
                "Sor—!",
                "Help—!",
            ],
            // hit flinches — one syllable
            "hurt": [
                "Ow!",
                "Eep!",
                "Ah!",
                "Uh!",
                "Oof!",
            ],
        },

    },
}
