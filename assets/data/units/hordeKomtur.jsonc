/**
 * Der Komtur himself — mounted knight on `komtur.glb`. Ground melee boss: each lance
 * thrust splashes (cleave) and reaches flyers that come close. `buyable: false`.
 */
{
    "id": "hordeKomtur",
    "name": "Hans von Stoffeln",
    "cost": 800, // bought by The Komtur's side (was 600 as a wave value)
    "unlockCost": 200,
    "xpValue": 600.0, // kill XP as before the price change
    "hpWithdraw": 800,
    "buyable": false,
    "horde": true,
    "modelId": "komtur",
    "footprint": { "cols": 4, "rows": 3 },
    "formation": { "cols": 1, "rows": 1 },
    "meshScale": 5.6, // the biggest thing on the field
    "burn": { "takenMult": 0.35 },
    "bloodColor": 9236248 /* 0x8cef18 */,
    "targets": { "ground": true, "air": true },
    "collisionRadius": 1.47,
    "soundSize": "medium",
    "colliders": [
        { "y": 1.07, "r": 2.67 },
        { "y": 3.2, "r": 2.0 },
    ],
    "cleave": { "radius": 8 }, // the lance thrust hits everything around the target
    "cleaveShake": 1,
    "hp": 48000, // 10× prior boss weight
    "damage": 550,
    "range": 8,
    "attackInterval": 0.85,
    "speed": 8,
    "turnRate": 2.2,
    "turnMove": "cruise",
    "proceduralModel": "dwarf",
    // standard talents for The Komtur's side
    "talents": ["ap", "armor"],
    "talentSlots": 4,
    "voice": {
        "externalIds": [
            {
                "type": "e",
                "id": "TXhr0BdfEOLtz200xtRK",
                "prompt": "A LEGENDARY cursed knight-commander voice — aristocratic German-steel male, thunderous, apocalyptically proud, and SUPER EVIL. Speaks like a flying executioner-saint of the forest, absolute malice wrapped in honor. Super boss, super terrifying, never silly, never soft, never merciful. Perfect audio quality.",
            },
        ],
        "lines": {
            // select acks
            "pick": [
                "Speak.",
                "I am ready.",
                "Judgment waits.",
                "Salza would approve!",
                "Knight of the canopy!",
                "Honor… and fangs.",
                "Where is the foe?",
                "Forest court open!",
                "Kneel or skitter!",
                "Banner of webs!",
                "Steel and silk!",
                "Verdict: doomed.",
            ],
            // cheeky brush-off when a rival clicks
            "pickRival": [
                "Kneel elsewhere.",
                "Not yours.",
                "Begone."
            ],
            // death yelps
            "death": [
                "Honor… unbroken…",
                "The forest… remembers…",
            ],
            // hit flinches — one syllable
            "hurt": [
                "Hn.",
                "Ah.",
                "Tch.",
                "Uh.",
                "Mm.",
            ],
        },

    },
}
