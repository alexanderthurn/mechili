    "voice": {
        "externalIds": [
            {
                "type": "e",
                "id": "biEMwb3WJC9rKYDJSghv",
                "prompt": "A MONSTROUS spider-mother voice — vast, wet, and SUPER EVIL. Slow hissing female menace with silk-and-venom luxury, savoring fear and death. Super villainous, super patient, never funny, never soft. Perfect audio quality.",
            },
        ],
        "lines": {
            // select acks
            "pick": [
                "Child…?",
                "Speak.",
                "I am waiting.",
                "Mother of many!",
                "Arachne reigns!",
                "Where brood?",
                "Nest is law.",
                "Silk throne!",
                "Patience… then bite.",
                "Little ones… feast!",
                "Web is doom.",
                "Creep… and kill!",
            ],
            // cheeky brush-off when a rival clicks
            "pickRival": [
                "Wrong child.",
                "Not yours.",
                "Away… or die."
            ],
            // death yelps
            "death": [
                "My brood…!",
                "This nest… falls…",
            ],
            // hit flinches — one syllable
            "hurt": [
                "Ah…",
                "Ss!",
                "Oh…",
                "Hn.",
                "Tch.",
            ],
        },

    },
