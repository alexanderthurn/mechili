/**
 * Mid spider pack — `horde.glb` at 2×. Distant fighters (special attacks later).
 * Smaller packs than Brut. `buyable: false`.
 */
{
    "id": "hordeWebweaver",
    "name": "Webweaver",
    "cost": 200, // bought by The Komtur's side
    "unlockCost": 50,
    "xpValue": 25.0, // kill XP as before the price change
    "hpWithdraw": 12,
    "buyable": false,
    "horde": true,
    "modelId": "horde",
    // a normal pack plate (goblin-sized)
    "footprint": { "cols": 4, "rows": 2 },
    "formation": { "cols": 4, "rows": 2 }, // 8 mechs, more spread out
    "formationSpread": 1.0,
    "meshScale": 1.0,
    "burn": { "takenMult": 0.5 },
    "bloodColor": 9236248 /* 0x8cef18 */,
    "targets": { "ground": true, "air": true },
    "collisionRadius": 0.7,
    "soundSize": "small",
    "colliders": [{ "y": 0.5, "r": 0.75 }],
    "sandWeight": 0.2,
    "projectileSpeed": 55,
    "projectileStyle": "bolt",
    "corrodeOnHit": { "seconds": 5 },
    "hp": 210,
    "damage": 100,
    "range": 16,
    "attackInterval": 0.9,
    "speed": 12,
    "turnRate": 5,
    "proceduralModel": "dwarf",
    // standard talents for The Komtur's side
    "talents": ["barrel", "ap", "autoloader"],
    "talentSlots": 4,
    "voice": {
        "externalIds": [
            {
                "type": "e",
                "prompt": "A sly, whispering web-assassin voice — thin, venomous, and wickedly amused. Speaks close and intimate like a trap closing, with cruel delight. Super sneaky evil, never booming, never dumb ogre. Perfect audio quality.",
            },
        ],
        "lines": {
            // select acks
            "pick": [
                "Yes…?",
                "Closer.",
                "I hear you.",
            ],
            // cheeky brush-off when a rival clicks
            "pickRival": [
                "Closer—no.",
                "Silk says no.",
                "Leave."
            ],
            // death yelps
            "death": [
                "Silk… tears…",
                "No—!",
            ],
            // hit flinches — one syllable
            "hurt": [
                "Ah!",
                "Ss!",
                "Tch!",
                "Ih!",
                "Hn!",
            ],
        },

    },
}
