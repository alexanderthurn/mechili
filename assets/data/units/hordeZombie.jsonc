    "voice": {
        "externalIds": [
            {
                "type": "e",
                "id": "cwe571X5eMyxKhiBcUKp",
                "prompt": "A HORRIFIC rotting swarm voice — wet gurgles, broken hunger, and relentless evil. Speaks in choked undead rasps with pack-animal craving. Super disgusting, super threatening, zero charm, zero comedy relief. Perfect audio quality.",
            },
        ],
        "lines": {
            // select acks
            "pick": [
                "…Food?",
                "Uuuh.",
                "More…",
                "Braaains… maybe.",
                "Hungry still.",
                "Where picnic?",
                "Chew later.",
                "I am… Bob?",
                "Slow but snacky.",
                "Door? Nom.",
                "Fresh…?",
                "Uuuh-yes.",
            ],
            // cheeky brush-off when a rival clicks
            "pickRival": [
                "…No.",
                "Not food.",
                "Uuuh—no."
            ],
            // death yelps
            // huge pack: one syllable only
            "death": [
                "Urgh!",
                "Ungh!",
            ],
            // hit flinches — one syllable
            "hurt": [
                "Urgh!",
                "Guh!",
                "Ah!",
                "Nngh!",
                "Hrrk!",
            ],
