    "id": "hordeZombie", // keep legacy id for hydrate/replay
    "name": "Black Brood",
    "cost": 100, // bought by The Komtur's side
    "unlockCost": 0,
    "hpWithdraw": 2,
    "buyable": false,
    "horde": true,
