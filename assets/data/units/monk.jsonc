        ],
        "lines": {
            // select acks — ancient, kind, dry humour; short and on point
            "pick": [
                "Peace.",
                "Who's hurt?",
                "Bless you.",
                "Brother Tuck!",
                "Jesus loves you.",
                "Faith and bandages.",
                "Patience heals.",
                "Ninety and still praying.",
                "Pray, then patch.",
                "Ora et labora!",
                "Hold still.",
                "Mercy and mead.",
                "Whiskey's medicinal.",
                "Patrick did the snakes.",
                "Raining blood.",
                "Luck o' the Irish!",
