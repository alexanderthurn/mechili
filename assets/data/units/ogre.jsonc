{
    // Fantasy Rhino — single fast melee tank; small cleave, breakthrough / aggro soak
    "id": "ogre",
    "name": "Ogre",
    "cost": 200,
    "unlockCost": 50,
    "footprint": { "cols": 2, "rows": 2 },
    "formation": { "cols": 1, "rows": 1 },
    "meshScale": 3.48, // 1.2× base 2.9
    "burn": { "takenMult": 0.65 },
    "targets": { "ground": true, "air": false },
    "collisionRadius": 1.62,
    "soundSize": "large",
    "colliders": [
        { "y": 1.2, "r": 1.2 },
        { "y": 2.4, "r": 0.9 },
    ],
    // innate disk like Rhino splash — Whirlwind tech widens it
    "cleave": { "radius": 2 },
    "cleaveScar": false, // no ground crater stamp on swings
    "hp": 1620,
    "damage": 195,
    "range": 3.4, // short melee reach
    // Match cadence to the long pitch (~1.27s visual @ fireSpeed 3)
    "attackInterval": 1.35,
    // Hit late in the throw (visual ~1.27s)
    "meleeHitDelay": 0.6,
    // commit early at speed 8.5 → slide into the smash
    "meleeLunge": 5,
    "meleePress": 0.85, // keep closing while swinging (the charge feel)
    "speed": 8.5, // faster than dwarf (6) — Rhino closes gaps
    "turnRate": 4, // heavy body — was 9 (too snappy for a big melee)
    "sandWeight": 1.5,
    "proceduralModel": "ogre",
    // Breakthrough pivots
    "talents": ["whirlwind", "bloodRage", "armor", "regeneration", "bloodfeast", "carrionFeast", "ruinousEnd"],
    "talentSlots": 4,
    "voice": {
        "externalIds": [
            {
                "type": "e",
                "id": "vUjcQV1NreRZSHLLiuYY",
                "prompt": "A GIGANTIC stupid-powerful male ogre voice — mountain-deep, wet, and hilariously blunt. Speaks with slow meaty enthusiasm, like violence is a snack. Booming, dumb, delightful, and slightly wet-mouthed. Ultra strong and ultra funny, never clever, never quiet. Perfect audio quality.",
            },
        ],
        "lines": {
            // select acks
            "pick": [
                "Huh?",
                "Smash?",
                "Me ready!",
            ],
            // cheeky brush-off when a rival clicks
            "pickRival": [
                "No smash you.",
                "Go away!",
                "Not friend!"
            ],
            // death yelps
            "death": [
                "Owww…",
                "No more smash…",
            ],
            // hit flinches — one syllable
            "hurt": [
                "Ow!",
                "Ugh!",
                "Oof!",
                "Ah!",
                "Buh!",
            ],
        },

    },
}
