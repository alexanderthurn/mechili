{
    // First giant: Melting Point–style ramping sunlight beam on a static mortar hull.
    // One mech, no anims — muzzle from rampBeam.muzzleLocal (barrel mouth).
    "id": "prismCannon",
    "name": "Arcane Prism Cannon",
    "cost": 400,
    "unlockCost": 200,
    "hpWithdraw": 400,
    "footprint": { "cols": 4, "rows": 4 },
    "formation": { "cols": 1, "rows": 1 },
    "meshScale": 3.6,
    "modelId": "mortar",
    "targets": { "ground": true, "air": true },
    "collisionRadius": 2.6,
    "colliders": [
        { "y": 0.9, "r": 1.2 },
        { "y": 2.2, "r": 0.7 },
    ],
    "rampBeam": {
        "range": 105,
        "doubleEvery": 1.25,
        "maxDps": 1000000,
        "splashRadius": 3,
        // Rest-local barrel mouth on mortar mesh (before meshScale); toward −Z.
        "muzzleLocal": { "x": 0, "y": 1.95, "z": -1.35 },
    },
    "sandWeight": 1.15,
    "deathWear": "ash",
    "deathAshScorch": { "radius": 1.2, "strength": 0.25 },
    "burn": { "takenMult": 3.0 },
    "hp": 1000,
    // Also rampBeam starting DPS (talents like AP scale this via resolved stats).
    "damage": 10,
    "range": 105,
    "attackInterval": 0.2,
    "speed": 2.0,
    "turnRate": 0.9,
    "turnMove": "pivot",
    "proceduralModel": "mortar",
    "talents": ["barrel", "armor", "ap", "powerDraw", "skyhunt", "groundhunt", "veteranAim"],
    "talentSlots": 4,
}
