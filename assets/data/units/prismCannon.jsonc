{
    // First giant: Melting Point–style ramping sunlight beam.
    // Static prismcannon.glb — beam origin from GLB AttackNode (Tripo +X front).
    "id": "prismCannon",
    "name": "Prism Cannon",
    "cost": 400,
    "unlockCost": 200,
    "hpWithdraw": 400,
    "footprint": { "cols": 4, "rows": 4 },
    "formation": { "cols": 1, "rows": 1 },
    "meshScale": 5.0,
    "targets": { "ground": true, "air": true },
    "collisionRadius": 2.6,
    "colliders": [
        { "y": 0.9, "r": 1.2 },
        { "y": 2.2, "r": 0.7 },
    ],
    "rampBeam": {
        "doubleEvery": 1,
        "maxDps": 1000000,
        "splashRadius": 3,
        // Tight horizontal cone — must yaw to engage flanks; pitch free.
        "fireYawHalfDeg": 18,
    },
    "sandWeight": 1.15,
    "deathWear": "ash",
    "deathAshScorch": { "radius": 1.2, "strength": 0.25 },
    "burn": { "takenMult": 3.0 },
    "hp": 1000,
    // Also rampBeam starting DPS (talents like AP scale this via resolved stats).
    "damage": 10,
    "range": 52,
    "attackInterval": 0.2,
    "speed": 2.0,
    // Slow traverse: flankers can outrun the cone and break the lock.
    "turnRate": 0.1,
    "turnMove": "pivot",
    // Wheeled siege — little gait wobble while rolling.
    "walkLean": 0.2,
    "proceduralModel": "mortar",
    "talents": ["barrel", "armor", "massBinding", "bloodfeast"],
    "talentSlots": 4,
    "voice": {
        "externalIds": [
            {
                "type": "e",
                "prompt": "A cold, crystalline techno-mage voice — glittering, inhuman, and beautifully cruel. Speaks with laser-clean diction and eerie calm, like light itself is judging you. Super sci-fantasy menace, never folksy, never booming ogre. Perfect audio quality.",
            },
        ],
    },
}
