{
    "id": "wall",
    "name": "Stone Wall",
    "cost": 100,
    // experiment: one 4-cell piece, lying across the battlefield
    "footprint": { "cols": 4, "rows": 1 },
    "formation": { "cols": 1, "rows": 1 },
    "meshScale": 1,
    "structure": true,
    "extra": true,
    "burn": { "takenMult": 0 },
    "targets": { "ground": false, "air": false },
    // solid for ground units, world units from the centre: tower to tower (the towers stand on
    // the centres of the end tiles, ±6), as deep as the towers
    "wall": {
        "halfLength": 6.9,
        "halfDepth": 1.3,
        "upgradeCost": 10,
        "heightPerLevel": 0.25,
        // solid to shots below the crown (× the model's height): flat shots stop in it, lobs pass over
        "crown": 0.8,
        // experiment: archers on the walkway — two, a quarter of the way in from
        // each end, on the walkway's top (≈ 0.48 of the wall's height), behind its middle
        "posts": { "count": 2, "unitTypeId": "wall-archer", "cost": 100, "spacing": 3, "back": 1.5, "top": 0.48, "crown": 0.8, "rise": 0.8 },
    },
    "collisionRadius": 1,
    "soundSize": "large",
    "colliders": [], // nothing aims at it — its solid box (wall.crown) stops shots instead
    "hp": 4000,
    "damage": 0,
    "range": 0,
    "attackInterval": 1,
    "speed": 0,
    "proceduralModel": "tower",
}
