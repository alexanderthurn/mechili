// fantasy conversion (Melodan): P1 super-low-poly, static + procedural.
// `scale` multiplies the auto-fitted size (default 1) for art tweaks.
{
    "file": "dwarf.glb",
    "yawDeg": 90,
    "scale": 3,
    // soles sit a hair above the bbox floor — nudge feet into the lawn
    "offset": { "y": -0.04 },
}
