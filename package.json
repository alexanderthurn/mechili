{
  "name": "melodan",
  "version": "0.6.19",
  "description": "MELODAN — a fantasy auto-battler.",
  "type": "module",
  "license": "GPL-3.0",
  "steamElectronBuild": {
    "productName": "Melodan",
    "appId": "com.feuerware.melodan",
    "steamAppId": 4987230,
    "executableName": "Melodan",
    "lan": true
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "start": "steam-electron-build dev",
    "build:mac": "steam-electron-build mac",
    "build:win": "steam-electron-build win",
    "build:linux": "steam-electron-build linux",
    "icons:split": "uv run --with pillow python scripts/split_icon_sheets.py",
    "icons:pack": "printf 'agree\\n' | TexturePacker --format json --sheet misc/icons/icons.png --data assets/icons/icons.json --algorithm MaxRects --max-size 2048 --size-constraints POT --trim-mode None --padding 2 --extrude 1 --disable-rotation misc/icons/src && uv run --with pillow python -c \"from PIL import Image; Image.open('misc/icons/icons.png').save('assets/icons/icons.webp','WEBP',quality=90,method=6)\"",
    "models:draco": "bash scripts/compress-glb-draco.sh",
    "models:textures-1k": "bash scripts/resize-glb-textures.sh 1024",
    "start:playtest": "SteamAppId=${MELODAN_PLAYTEST_APP_ID:-5115110} steam-electron-build dev"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "pixi.js": "^8.19.0",
    "steam-electron-build": "github:alexanderthurn/steam-electron-build",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  }
}
